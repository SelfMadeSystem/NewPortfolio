---
// Retro-futuristic theme with glitch effects.
import { RippleGL } from '../components/RippleGL';
import { WebGLText } from '../components/WebGLText';
import { HashVisible } from '../components/HashVisible';
import Layout from '../layout/Layout.astro';
import '../styles/backend.css';

const description =
  "When applications need to handle millions of users or process complex data, that's where I shine. I've built everything from high-traffic Discord bots to sophisticated development tools and military-grade applications, always focusing on performance, reliability, and developer experience.";
---

<Layout description={description}>
  <RippleGL client:load />

  <script src="../components/ShuffleText.ts"></script>

  <div class="min-h-screen text-gray-100 font-mono flex flex-col">
    <header class="outline outline-white backdrop-rainbow">
      <shuffle-text class="left-2 top-2">Shoghi Simon's Portfolio</shuffle-text>
      <h1 class="text-4xl md:text-5xl w-fit pt-2 pb-4">
        <shuffle-text>Backend Development</shuffle-text>
      </h1>
      <a href="/" class="absolute right-0 top-2 text-blue-400 hover:underline">
        <shuffle-text class="p-2">← Back</shuffle-text>
      </a>
    </header>
    <main class="flex flex-row grow">
      <aside class="border-r border-white p-2 backdrop-rainbow">
        <nav class="flex flex-col space-y-4 text-lg">
          <a href="#projects" class="text-indigo-400 hover:underline"
            ><shuffle-text>Projects</shuffle-text></a
          >
          <a href="#technologies" class="text-indigo-400 hover:underline"
            ><shuffle-text>Technologies</shuffle-text></a
          >
        </nav>
      </aside>
      <section class="max-w-5xl mx-auto pb-8">
        <div class="p-8">
          <WebGLText client:load
            ><shuffle-text no-shuffle>{description}</shuffle-text></WebGLText
          >
        </div>
        <HashVisible
          client:load
          id="projects"
          defaultVisible
          class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8"
        >
          <!-- Countryvia -->
          <div
            class="border p-8 flex flex-col justify-between backdrop-rainbow"
          >
            <h3 class="text-3xl mb-2">
              <shuffle-text>Countryvia</shuffle-text>
            </h3>
            <p class="text-lg mb-4">
              <shuffle-text>
                I took over development of Countryvia, a popular Discord trivia
                bot focused on geography and country facts. Built with Node.js
                and TypeScript, it serves over 65,000 servers and 2 million
                users, making it one of Discord's most widely-used trivia bots.
              </shuffle-text>
            </p>
            <ul class="text-base mb-4 text-left">
              <li><shuffle-text>• NodeJS</shuffle-text></li>
              <li><shuffle-text>• TypeScript</shuffle-text></li>
              <li><shuffle-text>• Discord.JS</shuffle-text></li>
            </ul>
            <a
              href="https://discord.gg/4vSs3KJUNN"
              target="_blank"
              class="inline-block mt-auto text-white"
            >
              <shuffle-text
                class="block px-4 py-2 border-4 border-indigo-700 hover:border-indigo-800"
                >Join the Discord</shuffle-text
              >
            </a>
          </div>
          <!-- Countryvia -->
          <div
            class="border p-8 flex flex-col justify-between backdrop-rainbow"
          >
            <h3 class="text-3xl mb-2">
              <shuffle-text>Logbook 34 Sigs</shuffle-text>
            </h3>
            <p class="text-lg mb-4">
              <shuffle-text>
                Logbook made for the 34th Signal Regiment of the Canadian Armed
                Forces. A Progressive Web App and native Tauri app for keeping
                track of radio communications during exercises and operations.
                Features offline support, real-time multi-tab synchronization,
                CSV and Excel export, and extensive auditing capabilities. Has
                seen real-world use in military exercises.
              </shuffle-text>
            </p>
            <ul class="text-base mb-4 text-left">
              <li><shuffle-text>• Bun</shuffle-text></li>
              <li><shuffle-text>• TypeScript</shuffle-text></li>
              <li><shuffle-text>• TailwindCSS</shuffle-text></li>
              <li><shuffle-text>• React</shuffle-text></li>
            </ul>
            <a
              href="https://logbook.shoghisimon.ca/"
              target="_blank"
              class="inline-block mt-auto text-white"
            >
              <shuffle-text
                class="block px-4 py-2 border-4 border-indigo-700 hover:border-indigo-800"
                >Visit</shuffle-text
              >
            </a>
          </div>
          <!-- Monaco-Tailwind -->
          <div
            class="border p-8 flex flex-col justify-between backdrop-rainbow"
          >
            <h3 class="text-3xl mb-2">
              <shuffle-text>Monaco Tailwind</shuffle-text>
            </h3>
            <p class="text-lg mb-4">
              <shuffle-text>
                A seamless integration of TailwindCSS v4 into the Monaco Editor,
                enhancing developer productivity with features like
                autocompletion, linting, hover previews and CSS generation. Used
                in my Live JSX Editor project and made for uiverse.io
              </shuffle-text>
            </p>
            <ul class="text-base mb-4 text-left">
              <li><shuffle-text>• TypeScript</shuffle-text></li>
              <li><shuffle-text>• TailwindCSS</shuffle-text></li>
              <li><shuffle-text>• Monaco Editor</shuffle-text></li>
            </ul>
            <a
              href="https://www.npmjs.com/package/monaco-tailwind"
              target="_blank"
              class="inline-block mt-auto text-white"
            >
              <shuffle-text
                class="block px-4 py-2 border-4 border-indigo-700 hover:border-indigo-800"
                >Visit</shuffle-text
              >
            </a>
          </div>
          <!-- Live JSX Editor -->
          <div
            class="border p-8 flex flex-col justify-between backdrop-rainbow"
          >
            <h3 class="text-3xl mb-2">
              <shuffle-text>Live JSX Editor</shuffle-text>
            </h3>
            <p class="text-lg mb-4">
              <shuffle-text>
                A real-time JSX editor with live preview, featuring multi-file
                support, NPM package imports, and advanced tooling. Built with
                custom esbuild integration and TailwindCSS v4 support for a
                seamless development experience. Perfect for prototyping and
                sharing React components quickly.
              </shuffle-text>
            </p>
            <ul class="text-base mb-4 text-left">
              <li><shuffle-text>• TypeScript</shuffle-text></li>
              <li><shuffle-text>• React</shuffle-text></li>
              <li><shuffle-text>• esbuild</shuffle-text></li>
              <li><shuffle-text>• TailwindCSS</shuffle-text></li>
              <li><shuffle-text>• Monaco Editor</shuffle-text></li>
            </ul>
            <a
              href="https://live-jsx-app.shoghisimon.ca/"
              target="_blank"
              class="inline-block mt-auto text-white"
            >
              <shuffle-text
                class="block px-4 py-2 border-4 border-indigo-700 hover:border-indigo-800"
                >Visit</shuffle-text
              >
            </a>
          </div>
          <!-- ServerScripter -->
          <div
            class="border p-8 flex flex-col justify-between backdrop-rainbow"
          >
            <h3 class="text-3xl mb-2">
              <shuffle-text>ServerScripter</shuffle-text>
            </h3>
            <p class="text-lg mb-4">
              <shuffle-text>
                A multi-platform Minecraft plugin that enables server-side
                scripting in multiple languages. Designed for cross-platform
                compatibility, it's been powering MC-Galaxy since 2021,
                dramatically speeding up feature development through rapid
                script implementation.
              </shuffle-text>
            </p>
            <ul class="text-base mb-4 text-left">
              <li><shuffle-text>• Java</shuffle-text></li>
              <li><shuffle-text>• Gradle</shuffle-text></li>
            </ul>
            <a
              href="https://github.com/SelfMadeSystem/ServerScripter"
              target="_blank"
              class="inline-block mt-auto text-white"
            >
              <shuffle-text
                class="block px-4 py-2 border-4 border-indigo-700 hover:border-indigo-800"
                >Visit</shuffle-text
              >
            </a>
          </div>
        </HashVisible>
        <HashVisible
          client:load
          id="technologies"
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 text-center"
        >
          <div>
            <h2 class="text-2xl mb-2">
              <shuffle-text>Languages</shuffle-text>
            </h2>
            <ul class="space-y-1">
              <li><shuffle-text>TypeScript</shuffle-text></li>
              <li><shuffle-text>Java</shuffle-text></li>
              <li><shuffle-text>Rust</shuffle-text></li>
              <li><shuffle-text>C#</shuffle-text></li>
              <li><shuffle-text>GDScript</shuffle-text></li>
              <li><shuffle-text>PHP</shuffle-text></li>
              <li><shuffle-text>Python</shuffle-text></li>
            </ul>
          </div>
          <div class="border-x">
            <h2 class="text-2xl mb-2">
              <shuffle-text>Frameworks</shuffle-text>
            </h2>
            <ul class="space-y-1">
              <li><shuffle-text>Next.JS</shuffle-text></li>
              <li><shuffle-text>Node.JS</shuffle-text></li>
              <li><shuffle-text>Bun.JS</shuffle-text></li>
              <li><shuffle-text>ASP.NET</shuffle-text></li>
              <li><shuffle-text>Express.JS</shuffle-text></li>
            </ul>
          </div>
          <div>
            <h2 class="text-2xl mb-2"><shuffle-text>Tools</shuffle-text></h2>
            <ul class="space-y-1">
              <li><shuffle-text>Google</shuffle-text></li>
              <li><shuffle-text>Git</shuffle-text></li>
              <li><shuffle-text>VSCode</shuffle-text></li>
              <li><shuffle-text>Fish</shuffle-text></li>
              <li><shuffle-text>Bash</shuffle-text></li>
              <li><shuffle-text>Nix</shuffle-text></li>
            </ul>
          </div>
          <div class="border-x">
            <h2 class="text-2xl mb-2">
              <shuffle-text>Systems</shuffle-text>
            </h2>
            <ul class="space-y-1">
              <li><shuffle-text>Nginx</shuffle-text></li>
              <li><shuffle-text>Linux</shuffle-text></li>
              <li><shuffle-text>Apache2</shuffle-text></li>
              <li><shuffle-text>Podman</shuffle-text></li>
              <li><shuffle-text>Docker</shuffle-text></li>
            </ul>
          </div>
          <div>
            <h2 class="text-2xl mb-2">
              <shuffle-text>Services</shuffle-text>
            </h2>
            <ul class="space-y-1">
              <li><shuffle-text>libSQL</shuffle-text></li>
              <li><shuffle-text>PostgreSQL</shuffle-text></li>
              <li><shuffle-text>MySQL</shuffle-text></li>
              <li><shuffle-text>MinIO</shuffle-text></li>
              <li><shuffle-text>MariaDB</shuffle-text></li>
              <li><shuffle-text>SQLite</shuffle-text></li>
            </ul>
          </div>
        </HashVisible>
      </section>
    </main>
    <footer
      class="outline outline-white text-center p-4 mt-auto backdrop-rainbow"
    >
      <shuffle-text
        >© {new Date().getFullYear()} Shoghi Simon. All rights reserved.</shuffle-text
      >
    </footer>
  </div>
</Layout>
