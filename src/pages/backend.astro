---
// Retro-futuristic theme with glitch effects.
import { RippleGL } from '../components/RippleGL';
import { WebGLText } from '../components/WebGLText';
import { HashVisible } from '../components/HashVisible';
import Layout from '../layout/Layout.astro';
import '../styles/backend.css';

const description =
  "When applications need to handle millions of users or process complex data, that's where I shine. I've built everything from high-traffic Discord bots to sophisticated development tools and military-grade applications, always focusing on performance, reliability, and developer experience.";
---

<Layout description={description}>
  <RippleGL client:load />

  <script src="../components/ShuffleText.ts"></script>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const anchors = document.querySelectorAll("a[href^='#']");
      let currentFragment = window.location.hash;

      if (!currentFragment) {
        currentFragment = '#case-studies';
      }

      anchors.forEach(anchor => {
        if (anchor.getAttribute('href') === currentFragment) {
          anchor.classList.add('active-tab');
        } else {
          anchor.classList.remove('active-tab');
        }
      });

      window.addEventListener('hashchange', () => {
        const newFragment = window.location.hash;

        anchors.forEach(anchor => {
          if (anchor.getAttribute('href') === newFragment) {
            anchor.classList.add('active-tab');
          } else {
            anchor.classList.remove('active-tab');
          }
        });
      });
    });
  </script>

  <div class="min-h-screen text-gray-100 font-mono flex flex-col">
    <header class="border-b border-white backdrop-rainbow">
      <shuffle-text class="left-2 top-2">Shoghi Simon's Portfolio</shuffle-text>
      <h1 class="text-4xl md:text-5xl w-fit pt-2 pb-4">
        <shuffle-text>Backend Development</shuffle-text>
      </h1>
      <a href="/" class="absolute right-0 top-2 text-blue-400 hover:underline">
        <shuffle-text shuffle class="p-2">← Back</shuffle-text>
      </a>
    </header>
    <main class="flex flex-col md:flex-row grow">
      <aside
        class="max-md:border-b md:border-r border-white p-2 backdrop-rainbow"
      >
        <nav class="flex flex-col space-y-4 text-lg">
          <a
            href="#case-studies"
            class="px-2 py-1 text-indigo-400 hover:underline"
            ><shuffle-text shuffle>Case Studies</shuffle-text></a
          >
          <a href="#projects" class="px-2 py-1 text-indigo-400 hover:underline"
            ><shuffle-text shuffle>Projects</shuffle-text></a
          >
        </nav>
      </aside>
      <section class="max-w-5xl mx-auto pb-8">
        <div class="p-8">
          <WebGLText client:load
            ><shuffle-text no-shuffle>{description}</shuffle-text></WebGLText
          >
        </div>
        <HashVisible
          client:load
          id="case-studies"
          defaultVisible
          className="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8"
        >
          <!-- Countryvia -->
          <div
            class="border p-8 flex flex-col justify-between backdrop-rainbow"
          >
            <h3 class="text-3xl mb-2">
              <shuffle-text>Countryvia</shuffle-text>
            </h3>
            <p class="text-sm mb-4">
              <shuffle-text>Scale and Reliability</shuffle-text>
            </p>
            <p class="text-lg mb-4">
              <shuffle-text>
                Took over a high-traffic Discord bot serving 2M users across 67k
                servers. Implemented sharding, optimized database queries, and
                introduced caching layers to handle load, all while using
                limited resources. The result was a 40% reduction in latency and
                zero downtime during peak usage.
              </shuffle-text>
            </p>
            <ul class="text-base mb-4 text-left">
              <li><shuffle-text>99% uptime</shuffle-text></li>
              <li><shuffle-text>40% lower average latency</shuffle-text></li>
              <li><shuffle-text>Reduced server costs by 25%</shuffle-text></li>
            </ul>
            <a
              href="https://discord.gg/4vSs3KJUNN"
              target="_blank"
              class="inline-block mt-auto text-white"
            >
              <shuffle-text
                class="block px-4 py-2 border-4 border-indigo-700 hover:border-indigo-800"
                shuffle>Join the Discord</shuffle-text
              >
            </a>
          </div>
          <!-- Logbook 34 Sigs -->
          <div
            class="border p-8 flex flex-col justify-between backdrop-rainbow"
          >
            <h3 class="text-3xl mb-2">
              <shuffle-text>Logbook 34 Sigs</shuffle-text>
            </h3>
            <p class="text-sm mb-4">
              <shuffle-text>PWA for field operations</shuffle-text>
            </p>
            <p class="text-lg mb-4">
              <shuffle-text>
                Developed a Progressive Web App and native Tauri app for the
                Canadian Armed Forces' 34th Signal Regiment to log radio
                communications during field exercises. Features include offline
                support, real-time multi-tab sync, PDF, CSV, and Excel export,
                and auditing. The app has been successfully used in real
                military operations.
              </shuffle-text>
            </p>
            <ul class="text-base mb-4 text-left">
              <li><shuffle-text>Offline-first</shuffle-text></li>
              <li>
                <shuffle-text>Real-time multi-tab sync</shuffle-text>
              </li>
              <li><shuffle-text>PDF and Excel export</shuffle-text></li>
            </ul>
            <a
              href="https://logbook.shoghisimon.ca/"
              target="_blank"
              class="inline-block mt-auto text-white"
            >
              <shuffle-text
                class="block px-4 py-2 border-4 border-indigo-700 hover:border-indigo-800"
                shuffle>Visit</shuffle-text
              >
            </a>
          </div>
          <!-- Live JSX Editor -->
          <div
            class="border p-8 flex flex-col justify-between backdrop-rainbow"
          >
            <h3 class="text-3xl mb-2">
              <shuffle-text>Live JSX Editor</shuffle-text>
            </h3>
            <p class="text-sm mb-4">
              <shuffle-text>Tooling and DX</shuffle-text>
            </p>
            <p class="text-lg mb-4">
              <shuffle-text>
                Created a real-time JSX editor with live preview, multi-file
                support, NPM package imports, and advanced tooling. Built with
                custom esbuild integration and TailwindCSS v4 support, it
                provides a seamless development experience for prototyping and
                sharing React components quickly.
              </shuffle-text>
            </p>
            <ul class="text-base mb-4 text-left">
              <li><shuffle-text>Real-time JSX editing</shuffle-text></li>
              <li><shuffle-text>NPM package imports</shuffle-text></li>
              <li><shuffle-text>TailwindCSS v4 support</shuffle-text></li>
            </ul>
            <a
              href="https://live-jsx-app.shoghisimon.ca/"
              target="_blank"
              class="inline-block mt-auto text-white"
            >
              <shuffle-text
                class="block px-4 py-2 border-4 border-indigo-700 hover:border-indigo-800"
                shuffle>Visit</shuffle-text
              >
            </a>
          </div>
        </HashVisible>
        <HashVisible
          client:load
          id="projects"
          className="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8"
        >
          <!-- pythonBoot -->
          <div
            class="border p-8 flex flex-col justify-between backdrop-rainbow"
          >
            <h3 class="text-3xl mb-2">
              <shuffle-text>pythonBoot</shuffle-text>
            </h3>
            <p class="text-lg mb-4">
              <shuffle-text>
                A Python playground in the browser powered by Pyodide. Inspired
                by codeBoot, pythonBoot provides a seamless Python coding
                experience suitable for beginners and experienced developers
                alike. It features a custom Monaco Editor setup, real-time code
                execution, step-by-step debugging, and support for popular
                Python libraries, all running entirely in the browser without
                any server-side code execution.
              </shuffle-text>
            </p>
            <ul class="text-base mb-4 text-left">
              <li><shuffle-text>• TypeScript</shuffle-text></li>
              <li><shuffle-text>• React</shuffle-text></li>
              <li><shuffle-text>• Pyodide</shuffle-text></li>
              <li><shuffle-text>• Monaco Editor</shuffle-text></li>
            </ul>
            <a
              href="https://pythonboot.shoghisimon.ca/"
              target="_blank"
              class="inline-block mt-auto text-white"
            >
              <shuffle-text
                class="block px-4 py-2 border-4 border-indigo-700 hover:border-indigo-800"
                shuffle>Visit</shuffle-text
              >
            </a>
          </div>
          <!-- Monaco-Tailwind -->
          <div
            class="border p-8 flex flex-col justify-between backdrop-rainbow"
          >
            <h3 class="text-3xl mb-2">
              <shuffle-text>Monaco Tailwind</shuffle-text>
            </h3>
            <p class="text-lg mb-4">
              <shuffle-text>
                A seamless integration of TailwindCSS v4 into the Monaco Editor,
                enhancing developer productivity with features like
                autocompletion, linting, hover previews and CSS generation. Used
                in my Live JSX Editor project and made for uiverse.io
              </shuffle-text>
            </p>
            <ul class="text-base mb-4 text-left">
              <li><shuffle-text>• TypeScript</shuffle-text></li>
              <li><shuffle-text>• TailwindCSS</shuffle-text></li>
              <li><shuffle-text>• Monaco Editor</shuffle-text></li>
            </ul>
            <a
              href="https://www.npmjs.com/package/monaco-tailwind"
              target="_blank"
              class="inline-block mt-auto text-white"
            >
              <shuffle-text
                class="block px-4 py-2 border-4 border-indigo-700 hover:border-indigo-800"
                shuffle>Visit</shuffle-text
              >
            </a>
          </div>
          <!-- ServerScripter -->
          <div
            class="border p-8 flex flex-col justify-between backdrop-rainbow"
          >
            <h3 class="text-3xl mb-2">
              <shuffle-text>ServerScripter</shuffle-text>
            </h3>
            <p class="text-lg mb-4">
              <shuffle-text>
                A multi-platform Minecraft plugin that enables server-side
                scripting in multiple languages. Designed for cross-platform
                compatibility, it's been powering MC-Galaxy since 2021,
                dramatically speeding up feature development through rapid
                script implementation.
              </shuffle-text>
            </p>
            <ul class="text-base mb-4 text-left">
              <li><shuffle-text>• Java</shuffle-text></li>
              <li><shuffle-text>• Gradle</shuffle-text></li>
            </ul>
            <a
              href="https://github.com/SelfMadeSystem/ServerScripter"
              target="_blank"
              class="inline-block mt-auto text-white"
            >
              <shuffle-text
                class="block px-4 py-2 border-4 border-indigo-700 hover:border-indigo-800"
                shuffle>Visit</shuffle-text
              >
            </a>
          </div>
          <!-- Live JSX Editor -->
          <div
            class="border p-8 flex flex-col justify-between backdrop-rainbow"
          >
            <h3 class="text-3xl mb-2">
              <shuffle-text>Live JSX Editor</shuffle-text>
            </h3>
            <p class="text-lg mb-4">
              <shuffle-text>
                A real-time JSX editor with live preview, featuring multi-file
                support, NPM package imports, and advanced tooling. Built with
                custom esbuild integration and TailwindCSS v4 support for a
                seamless development experience. Perfect for prototyping and
                sharing React components quickly.
              </shuffle-text>
            </p>
            <ul class="text-base mb-4 text-left">
              <li><shuffle-text>• TypeScript</shuffle-text></li>
              <li><shuffle-text>• React</shuffle-text></li>
              <li><shuffle-text>• esbuild</shuffle-text></li>
              <li><shuffle-text>• TailwindCSS</shuffle-text></li>
              <li><shuffle-text>• Monaco Editor</shuffle-text></li>
            </ul>
            <a
              href="https://live-jsx-app.shoghisimon.ca/"
              target="_blank"
              class="inline-block mt-auto text-white"
            >
              <shuffle-text
                class="block px-4 py-2 border-4 border-indigo-700 hover:border-indigo-800"
                shuffle>Visit</shuffle-text
              >
            </a>
          </div>

          <!-- Countryvia -->
          <div
            class="border p-8 flex flex-col justify-between backdrop-rainbow"
          >
            <h3 class="text-3xl mb-2">
              <shuffle-text>Countryvia</shuffle-text>
            </h3>
            <p class="text-lg mb-4">
              <shuffle-text>
                I took over development of Countryvia, a popular Discord trivia
                bot focused on geography and country facts. Built with Node.js
                and TypeScript, it serves over 67,000 servers and 2 million
                users, making it one of Discord's most widely-used trivia bots.
              </shuffle-text>
            </p>
            <ul class="text-base mb-4 text-left">
              <li><shuffle-text>• NodeJS</shuffle-text></li>
              <li><shuffle-text>• TypeScript</shuffle-text></li>
              <li><shuffle-text>• Discord.JS</shuffle-text></li>
            </ul>
            <a
              href="https://discord.gg/4vSs3KJUNN"
              target="_blank"
              class="inline-block mt-auto text-white"
            >
              <shuffle-text
                class="block px-4 py-2 border-4 border-indigo-700 hover:border-indigo-800"
                shuffle>Join the Discord</shuffle-text
              >
            </a>
          </div>
          <!-- Logbook 34 Sigs -->
          <div
            class="border p-8 flex flex-col justify-between backdrop-rainbow"
          >
            <h3 class="text-3xl mb-2">
              <shuffle-text>Logbook 34 Sigs</shuffle-text>
            </h3>
            <p class="text-lg mb-4">
              <shuffle-text>
                Logbook made for the 34th Signal Regiment of the Canadian Armed
                Forces. A Progressive Web App and native Tauri app for keeping
                track of radio communications during exercises and operations.
                Features offline support, real-time multi-tab synchronization,
                PDF and Excel export, and extensive auditing capabilities. Has
                seen real-world use in military exercises.
              </shuffle-text>
            </p>
            <ul class="text-base mb-4 text-left">
              <li><shuffle-text>• Bun</shuffle-text></li>
              <li><shuffle-text>• TypeScript</shuffle-text></li>
              <li><shuffle-text>• TailwindCSS</shuffle-text></li>
              <li><shuffle-text>• React</shuffle-text></li>
            </ul>
            <a
              href="https://logbook.shoghisimon.ca/"
              target="_blank"
              class="inline-block mt-auto text-white"
            >
              <shuffle-text
                class="block px-4 py-2 border-4 border-indigo-700 hover:border-indigo-800"
                shuffle>Visit</shuffle-text
              >
            </a>
          </div>
        </HashVisible>
      </section>
    </main>
    <footer
      class="outline outline-white text-center p-4 mt-auto backdrop-rainbow"
    >
      <shuffle-text
        >© {new Date().getFullYear()} Shoghi Simon. All rights reserved.</shuffle-text
      >
    </footer>
  </div>
</Layout>
