---
import Layout from '../layout/Layout.astro';
import WebPage from '../components/WebPage';
import '../styles/web.css';

const description =
  'Showcase of web development projects and animated experiments using React, Tailwind, and motion.';
---

<Layout description={description}>
  <!-- Hydrate the React component on load so animations run in the browser -->
  <WebPage client:load />
</Layout>
