---
import Layout from '../layout/Layout.astro';
import { Player } from '../components/game/Player';
import '../styles/game.css';
import Map from '../components/game/Map.astro';
import StarsCanvas from '../components/StarsCanvas';

const width = 6400;
const height = 4800;
const upscale = 1;
---

<Layout>
  <div id="scrollable">
    <div
      class="relative flex flex-wrap items-start justify-start overflow-hidden bg-black"
      style={`width: ${width * upscale}px; height: ${height * upscale}px;`}
    >
      <div class="fixed w-screen h-screen">
        <StarsCanvas client:load />
      </div>
      <Map />
      <Player client:load />
    </div>
  </div>
</Layout>
