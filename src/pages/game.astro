---
import Layout from '../layout/Layout.astro';
import { Player } from '../components/game/Player';
import '../styles/game.css';

const width = 640;
const height = 480;
const upscale = 5;
---

<Layout>
  <div id="scrollable">
    <div
      class="relative flex flex-wrap items-start justify-start overflow-hidden bg-black"
      style={`width: ${width * upscale}px; height: ${height * upscale}px;`}
    >
      <img
        src="/game/track.png"
        alt="Game Track"
        class="absolute top-0 left-0 w-full h-full object-cover [image-rendering:pixelated]"
        width={width}
        height={height}
      />
      <Player client:load />
    </div>
  </div>
</Layout>
