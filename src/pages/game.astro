---
import Layout from '../layout/Layout.astro';
import { Player } from '../components/game/Player';
import { Ghost } from '../components/game/Ghost';
import '../styles/game.css';
import Map from '../components/game/Map.astro';
import StarsCanvas from '../components/StarsCanvas';
import MiniMap from '../components/game/MiniMap.astro';
import { MAP_HEIGHT, MAP_WIDTH } from '../components/game/mapConsts';

const width = MAP_WIDTH;
const height = MAP_HEIGHT;
const upscale = 1;
---

<Layout>
  <div class="bg-black w-screen h-screen">
    <div class="fixed w-screen h-screen">
      <StarsCanvas client:load />
    </div>
    <div id="scrollable">
      <div
        class="relative flex flex-wrap items-start justify-start overflow-hidden"
        style={`width: ${width * upscale}px; height: ${height * upscale}px;`}
      >
        <Map />
        <Player client:load />
      </div>
    </div>
    <MiniMap />
  </div>
</Layout>
