---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  doUnloaded?: boolean;
}

const {
  title = "Shoghi Simon's Portfolio",
  description = "I've launched e-commerce sites that tripled sales, scaled Discord bots to millions, and delivered mission-critical military applications. Let's build something amazing together.",
  doUnloaded = false,
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Meta for SEO -->
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="Shoghi Simon, Portfolio, Shoghi, Simon, Shoghi Simon Portfolio, Developer, Software Engineer, Web Developer, Discord Bots, E-commerce, Development Tools"
    />
    <meta name="author" content="Shoghi Simon" />
    <meta name="og:title" content="Shoghi Simon's Portfolio" />
    <meta name="og:description" content={description} />
    <meta name="og:image" content="https://shoghisimon.ca/pfp.png" />
    <meta name="og:url" content="https://shoghisimon.ca" />
    <meta name="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Shoghi Simon's Portfolio" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://shoghisimon.ca/pfp.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class={doUnloaded ? 'unloaded' : ''}>
    <slot />
  </body>
</html>
