---
import {
  MAP_SVG_CONTENT,
  MAP_HEIGHT,
  MAP_VIEWBOX,
  MAP_WIDTH,
} from './mapConsts';
---

<div class="game-map">
  <Fragment set:html={MAP_SVG_CONTENT} />
</div>

<div id="game-minimap" style={`aspect-ratio: ${MAP_WIDTH}/${MAP_HEIGHT}`}>
  <svg
    viewBox={MAP_VIEWBOX}
    xmlns="http://www.w3.org/2000/svg"
    preserveAspectRatio="xMidYMid meet"
    width={MAP_WIDTH}
    height={MAP_HEIGHT}
  >
    <use href="#track-path"></use>
  </svg>
  <div
    id="player-indicator"
    class="absolute bg-blue-500 w-1 h-1 rounded-full -translate-1/2"
  >
  </div>
</div>

<style is:global>
  .game-map svg,
  #game-minimap svg {
    position: absolute;
    top: 0;
    left: 0;
    image-rendering: pixelated;
    width: 100%;
    height: 100%;
  }

  #game-minimap {
    position: fixed;
    bottom: 1rem;
    right: 1rem;
    width: 200px;
    outline: 2px solid white;
    background: #0008;
    z-index: 10;

    use {
      stroke: #0000;
      fill: #fff6;
    }
  }
</style>
