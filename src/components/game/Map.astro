---
import { MAP_SVG_CONTENT } from './mapConsts';
---

<div id="game-map">
  <Fragment set:html={MAP_SVG_CONTENT} />
</div>

<style is:global>
  #game-map {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  #game-map svg {
    position: absolute;
    top: 0;
    left: 0;
    image-rendering: pixelated;
    width: 100%;
    height: 100%;
  }

  #player-start {
    display: none;
  }
</style>
