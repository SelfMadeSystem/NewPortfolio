---
import GameSection from '../GameSection.astro';
import { SolidElement } from '../SolidElement';
---

<GameSection>
  <div
    class="absolute bottom-32 left-1/4 flex gap-4 text-6xl opacity-20 pointer-events-none"
  >
    <span class="animate-bounce" style="animation-delay: 0s;">♪</span>
    <span class="animate-bounce" style="animation-delay: 0.2s;">♫</span>
    <span class="animate-bounce" style="animation-delay: 0.4s;">♪</span>
  </div>

  <SolidElement
    className="bg-linear-to-br from-cyan-900 to-cyan-700 border-4 border-cyan-400 text-white rounded-2xl overflow-hidden w-96 h-96 shadow-2xl relative z-10"
    client:load
  >
    <div
      class="h-48 bg-cyan-950 overflow-hidden flex items-center justify-center relative"
    >
      <div class="absolute inset-0 bg-linear-to-b from-transparent to-cyan-950">
      </div>
      <img
        src="/assets/game/rhythm.png"
        alt="Rhythm Master"
        class="w-full h-full object-cover"
      />
    </div>
    <div class="p-6">
      <h2 class="text-2xl font-bold mb-2">Rhythm Master</h2>
      <p class="text-sm text-cyan-100">Music-driven gameplay</p>
      <div class="flex flex-wrap gap-1 mt-3">
        <span
          class="px-2 py-1 bg-cyan-500/30 border border-cyan-400 rounded-full text-xs"
        >
          Music
        </span>
        <span
          class="px-2 py-1 bg-cyan-500/30 border border-cyan-400 rounded-full text-xs"
        >
          Rhythm
        </span>
      </div>
    </div>
  </SolidElement>

  <SolidElement
    className="absolute top-1/3 left-1/3 bg-cyan-500/10 border-2 border-cyan-400 text-white p-4 rounded-lg w-48 shadow-lg"
    client:load
  >
    <div class="text-3xl mb-2">🎵</div>
    <h3 class="font-bold text-sm">Custom Songs</h3>
    <p class="text-xs text-cyan-200 mt-1">Upload your favorites</p>
  </SolidElement>

  <SolidElement
    className="absolute bottom-1/4 right-1/4 bg-cyan-500/10 border-2 border-cyan-400 text-white p-4 rounded-lg w-48 shadow-lg"
    client:load
  >
    <div class="text-3xl mb-2">🌍</div>
    <h3 class="font-bold text-sm">Global Leaderboards</h3>
    <p class="text-xs text-cyan-200 mt-1">Compete worldwide</p>
  </SolidElement>

  <SolidElement
    className="absolute top-1/2 right-1/3 bg-cyan-500/10 border-2 border-cyan-400 text-white p-4 rounded-lg w-48 shadow-lg"
    client:load
  >
    <div class="text-3xl mb-2">🎯</div>
    <h3 class="font-bold text-sm">Perfect Hit</h3>
    <p class="text-xs text-cyan-200 mt-1">Feel the beat</p>
  </SolidElement>

  <div
    class="absolute top-1/3 left-1/3 w-40 h-40 border-4 border-cyan-400/20 rounded-full animate-pulse"
  >
  </div>
</GameSection>
