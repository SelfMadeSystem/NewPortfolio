---
import GameSection from '../GameSection.astro';
import { SolidElement } from '../SolidElement';
---

<GameSection>
  <SolidElement
    className="bg-linear-to-br from-green-900 to-green-700 border-4 border-green-400 text-white rounded-2xl overflow-hidden w-96 h-96 shadow-2xl relative z-10"
    client:load
  >
    <div
      class="h-48 bg-green-950 overflow-hidden flex items-center justify-center relative"
    >
      <div
        class="absolute inset-0 bg-linear-to-b from-transparent to-green-950"
      >
      </div>
      <img
        src="/assets/game/puzzle.png"
        alt="Puzzle Engine"
        class="w-full h-full object-cover"
      />
    </div>
    <div class="p-6">
      <h2 class="text-2xl font-bold mb-2">Puzzle Engine</h2>
      <p class="text-sm text-green-100">Physics-based challenges</p>
      <div class="flex flex-wrap gap-1 mt-3">
        <span
          class="px-2 py-1 bg-green-500/30 border border-green-400 rounded-full text-xs"
        >
          Physics
        </span>
        <span
          class="px-2 py-1 bg-green-500/30 border border-green-400 rounded-full text-xs"
        >
          Puzzle
        </span>
      </div>
    </div>
  </SolidElement>

  <SolidElement
    className="absolute top-1/3 right-1/4 bg-green-500/10 border-2 border-green-400 text-white p-4 rounded-lg w-48 shadow-lg"
    client:load
  >
    <div class="text-3xl mb-2">🧩</div>
    <h3 class="font-bold text-sm">100+ Levels</h3>
    <p class="text-xs text-green-200 mt-1">Progressive difficulty</p>
  </SolidElement>

  <SolidElement
    className="absolute bottom-1/4 left-1/3 bg-green-500/10 border-2 border-green-400 text-white p-4 rounded-lg w-48 shadow-lg"
    client:load
  >
    <div class="text-3xl mb-2">⚙️</div>
    <h3 class="font-bold text-sm">Physics Engine</h3>
    <p class="text-xs text-green-200 mt-1">Realistic interactions</p>
  </SolidElement>

  <SolidElement
    className="absolute top-1/4 left-1/4 bg-green-500/10 border-2 border-green-400 text-white p-4 rounded-lg w-48 shadow-lg"
    client:load
  >
    <div class="text-3xl mb-2">💡</div>
    <h3 class="font-bold text-sm">Creative Solutions</h3>
    <p class="text-xs text-green-200 mt-1">Multiple approaches</p>
  </SolidElement>

  <div
    class="absolute bottom-1/4 right-1/4 text-7xl opacity-15 pointer-events-none"
  >
    🧩
  </div>
</GameSection>
