---
import GameSection from '../GameSection.astro';
import { SolidElement } from '../SolidElement';
---

<GameSection>
  <SolidElement
    className="bg-linear-to-br from-pink-900 to-pink-700 border-4 border-pink-400 text-white rounded-2xl overflow-hidden w-96 h-96 shadow-2xl relative z-10"
    client:load
  >
    <div
      class="h-48 bg-pink-950 overflow-hidden flex items-center justify-center relative"
    >
      <div class="absolute inset-0 bg-linear-to-b from-transparent to-pink-950">
      </div>
      <img
        src="/assets/game/narrative.png"
        alt="Narrative Quest"
        class="w-full h-full object-cover"
      />
    </div>
    <div class="p-6">
      <h2 class="text-2xl font-bold mb-2">Narrative Quest</h2>
      <p class="text-sm text-pink-100">Story-driven adventure</p>
      <div class="flex flex-wrap gap-1 mt-3">
        <span
          class="px-2 py-1 bg-pink-500/30 border border-pink-400 rounded-full text-xs"
        >
          Narrative
        </span>
        <span
          class="px-2 py-1 bg-pink-500/30 border border-pink-400 rounded-full text-xs"
        >
          Choices
        </span>
      </div>
    </div>
  </SolidElement>

  <SolidElement
    className="absolute top-1/3 left-1/4 bg-pink-500/10 border-2 border-pink-400 text-white p-4 rounded-lg w-48 shadow-lg"
    client:load
  >
    <div class="text-3xl mb-2">📖</div>
    <h3 class="font-bold text-sm">Branching Story</h3>
    <p class="text-xs text-pink-200 mt-1">Multiple endings</p>
  </SolidElement>

  <SolidElement
    className="absolute bottom-1/4 right-1/3 bg-pink-500/10 border-2 border-pink-400 text-white p-4 rounded-lg w-48 shadow-lg"
    client:load
  >
    <div class="text-3xl mb-2">🤝</div>
    <h3 class="font-bold text-sm">Dynamic NPCs</h3>
    <p class="text-xs text-pink-200 mt-1">Relationships matter</p>
  </SolidElement>

  <SolidElement
    className="absolute top-1/2 right-1/4 bg-pink-500/10 border-2 border-pink-400 text-white p-4 rounded-lg w-48 shadow-lg"
    client:load
  >
    <div class="text-3xl mb-2">⚡</div>
    <h3 class="font-bold text-sm">Your Choices</h3>
    <p class="text-xs text-pink-200 mt-1">Shape the world</p>
  </SolidElement>

  <div
    class="absolute bottom-1/4 left-20 text-9xl opacity-15 pointer-events-none"
  >
    📖
  </div>
</GameSection>
