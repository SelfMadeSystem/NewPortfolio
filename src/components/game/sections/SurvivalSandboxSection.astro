---
import GameSection from '../GameSection.astro';
import { SolidElement } from '../SolidElement';
---

<GameSection>
  <SolidElement
    className="bg-linear-to-br from-indigo-900 to-indigo-700 border-4 border-indigo-400 text-white rounded-2xl overflow-hidden w-96 h-96 shadow-2xl relative z-10"
    client:load
  >
    <div
      class="h-48 bg-indigo-950 overflow-hidden flex items-center justify-center relative"
    >
      <div
        class="absolute inset-0 bg-linear-to-b from-transparent to-indigo-950"
      >
      </div>
      <img
        src="/assets/game/survival.png"
        alt="Survival Sandbox"
        class="w-full h-full object-cover"
      />
    </div>
    <div class="p-6">
      <h2 class="text-2xl font-bold mb-2">Survival Sandbox</h2>
      <p class="text-sm text-indigo-100">Open-world exploration</p>
      <div class="flex flex-wrap gap-1 mt-3">
        <span
          class="px-2 py-1 bg-indigo-500/30 border border-indigo-400 rounded-full text-xs"
        >
          Survival
        </span>
        <span
          class="px-2 py-1 bg-indigo-500/30 border border-indigo-400 rounded-full text-xs"
        >
          Crafting
        </span>
      </div>
    </div>
  </SolidElement>

  <SolidElement
    className="absolute top-1/3 left-1/4 bg-indigo-500/10 border-2 border-indigo-400 text-white p-4 rounded-lg w-48 shadow-lg"
    client:load
  >
    <div class="text-3xl mb-2">🛠️</div>
    <h3 class="font-bold text-sm">Crafting</h3>
    <p class="text-xs text-indigo-200 mt-1">Build anything</p>
  </SolidElement>

  <SolidElement
    className="absolute bottom-1/3 right-1/3 bg-indigo-500/10 border-2 border-indigo-400 text-white p-4 rounded-lg w-48 shadow-lg"
    client:load
  >
    <div class="text-3xl mb-2">🏠</div>
    <h3 class="font-bold text-sm">Base Building</h3>
    <p class="text-xs text-indigo-200 mt-1">Your sanctuary</p>
  </SolidElement>

  <SolidElement
    className="absolute top-1/2 left-1/3 bg-indigo-500/10 border-2 border-indigo-400 text-white p-4 rounded-lg w-48 shadow-lg"
    client:load
  >
    <div class="text-3xl mb-2">☀️</div>
    <h3 class="font-bold text-sm">Dynamic Weather</h3>
    <p class="text-xs text-indigo-200 mt-1">Living world</p>
  </SolidElement>

  <div
    class="absolute top-1/2 right-1/4 text-9xl opacity-15 pointer-events-none"
  >
    🌲
  </div>
  <div
    class="absolute bottom-1/4 right-20 w-32 h-32 border-4 border-indigo-400/10 rounded-full animate-spin"
    style="animation-duration: 10s;"
  >
  </div>
</GameSection>
