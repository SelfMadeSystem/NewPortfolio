---
import GameSection from '../GameSection.astro';
import { SolidElement } from '../SolidElement';
---

<GameSection>
  <SolidElement
    className="bg-linear-to-br from-red-900 to-red-700 border-4 border-red-400 text-white rounded-2xl overflow-hidden w-96 h-96 shadow-2xl relative z-10"
    client:load
  >
    <div
      class="h-48 bg-red-950 overflow-hidden flex items-center justify-center relative"
    >
      <div class="absolute inset-0 bg-linear-to-b from-transparent to-red-950">
      </div>
      <img
        src="/assets/game/mech-arena.png"
        alt="Mech Arena"
        class="w-full h-full object-cover"
      />
    </div>
    <div class="p-6">
      <h2 class="text-2xl font-bold mb-2">Mech Arena</h2>
      <p class="text-sm text-red-100">Fast-paced action combat</p>
      <div class="flex flex-wrap gap-1 mt-3">
        <span
          class="px-2 py-1 bg-red-500/30 border border-red-400 rounded-full text-xs"
        >
          Action
        </span>
        <span
          class="px-2 py-1 bg-red-500/30 border border-red-400 rounded-full text-xs"
        >
          PvP
        </span>
      </div>
    </div>
  </SolidElement>

  <SolidElement
    className="absolute top-1/4 right-1/3 bg-red-500/10 border-2 border-red-400 text-white p-4 rounded-lg w-48 shadow-lg"
    client:load
  >
    <div class="text-3xl mb-2">🤖</div>
    <h3 class="font-bold text-sm">Customization</h3>
    <p class="text-xs text-red-200 mt-1">Build your mech</p>
  </SolidElement>

  <SolidElement
    className="absolute bottom-1/3 left-1/4 bg-red-500/10 border-2 border-red-400 text-white p-4 rounded-lg w-48 shadow-lg"
    client:load
  >
    <div class="text-3xl mb-2">💥</div>
    <h3 class="font-bold text-sm">Destruction</h3>
    <p class="text-xs text-red-200 mt-1">Destructible environments</p>
  </SolidElement>

  <SolidElement
    className="absolute top-1/2 left-1/3 bg-red-500/10 border-2 border-red-400 text-white p-4 rounded-lg w-48 shadow-lg"
    client:load
  >
    <div class="text-3xl mb-2">🏆</div>
    <h3 class="font-bold text-sm">Competitive</h3>
    <p class="text-xs text-red-200 mt-1">Rise to the top</p>
  </SolidElement>

  <div
    class="absolute top-1/4 right-1/3 text-8xl opacity-20 pointer-events-none animate-bounce"
    style="animation-duration: 3s;"
  >
    💥
  </div>
</GameSection>
