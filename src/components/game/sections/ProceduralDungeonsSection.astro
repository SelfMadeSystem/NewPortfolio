---
import GameSection from '../GameSection.astro';
import { SolidElement } from '../SolidElement';
---

<GameSection>
  <SolidElement
    className="bg-linear-to-br from-purple-900 to-purple-700 border-4 border-purple-400 text-white rounded-2xl overflow-hidden w-96 h-96 shadow-2xl relative z-10"
    client:load
  >
    <div
      class="h-48 bg-purple-950 overflow-hidden flex items-center justify-center relative"
    >
      <div
        class="absolute inset-0 bg-linear-to-b from-transparent to-purple-950"
      >
      </div>
      <img
        src="/assets/game/dungeon.png"
        alt="Procedural Dungeons"
        class="w-full h-full object-cover"
      />
    </div>
    <div class="p-6">
      <h2 class="text-2xl font-bold mb-2">Procedural Dungeons</h2>
      <p class="text-sm text-purple-100">Roguelike generation with AI</p>
      <div class="flex flex-wrap gap-1 mt-3">
        <span
          class="px-2 py-1 bg-purple-500/30 border border-purple-400 rounded-full text-xs"
        >
          Procedural Gen
        </span>
        <span
          class="px-2 py-1 bg-purple-500/30 border border-purple-400 rounded-full text-xs"
        >
          AI
        </span>
      </div>
    </div>
  </SolidElement>

  <SolidElement
    className="absolute top-20 left-1/4 bg-purple-500/10 border-2 border-purple-400 text-white p-4 rounded-lg w-48 shadow-lg"
    client:load
  >
    <div class="text-3xl mb-2">🗝️</div>
    <h3 class="font-bold text-sm">Loot Systems</h3>
    <p class="text-xs text-purple-200 mt-1">Dynamic item generation</p>
  </SolidElement>

  <SolidElement
    className="absolute bottom-1/4 right-1/4 bg-purple-500/10 border-2 border-purple-400 text-white p-4 rounded-lg w-48 shadow-lg"
    client:load
  >
    <div class="text-3xl mb-2">🧟</div>
    <h3 class="font-bold text-sm">Enemy AI</h3>
    <p class="text-xs text-purple-200 mt-1">Intelligent pathfinding</p>
  </SolidElement>

  <SolidElement
    className="absolute top-1/3 right-1/3 bg-purple-500/10 border-2 border-purple-400 text-white p-4 rounded-lg w-48 shadow-lg"
    client:load
  >
    <div class="text-3xl mb-2">📊</div>
    <h3 class="font-bold text-sm">100+ Levels</h3>
    <p class="text-xs text-purple-200 mt-1">Endless variety</p>
  </SolidElement>

  <div
    class="absolute top-1/3 right-12 text-8xl opacity-10 pointer-events-none"
  >
    🗝️
  </div>
</GameSection>
