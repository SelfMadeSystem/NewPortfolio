---
import GameSection from '../GameSection.astro';
import { SolidElement } from '../SolidElement';
---

<GameSection>
  <div
    class="absolute bottom-20 left-20 inline-block text-9xl opacity-20 pointer-events-none animate-bounce"
  >
    🚀
  </div>

  <SolidElement
    className="bg-linear-to-br from-blue-900 to-blue-700 border-4 border-blue-400 text-white rounded-2xl overflow-hidden w-96 h-96 shadow-2xl relative z-10"
    client:load
  >
    <div
      class="h-48 bg-blue-950 overflow-hidden flex items-center justify-center relative"
    >
      <div class="absolute inset-0 bg-linear-to-b from-transparent to-blue-950">
      </div>
      <img
        src="/assets/game/tactics.png"
        alt="Space Tactics"
        class="w-full h-full object-cover"
      />
    </div>
    <div class="p-6">
      <h2 class="text-2xl font-bold mb-2">Space Tactics</h2>
      <p class="text-sm text-blue-100">Turn-based multiplayer strategy</p>
      <div class="flex flex-wrap gap-1 mt-3">
        <span
          class="px-2 py-1 bg-blue-500/30 border border-blue-400 rounded-full text-xs"
        >
          Strategy
        </span>
        <span
          class="px-2 py-1 bg-blue-500/30 border border-blue-400 rounded-full text-xs"
        >
          PvP
        </span>
      </div>
    </div>
  </SolidElement>

  <SolidElement
    className="absolute top-1/4 left-1/3 bg-blue-500/10 border-2 border-blue-400 text-white p-4 rounded-lg w-48 shadow-lg"
    client:load
  >
    <div class="text-3xl mb-2">🛸</div>
    <h3 class="font-bold text-sm">Fleet Command</h3>
    <p class="text-xs text-blue-200 mt-1">Customize your ships</p>
  </SolidElement>

  <SolidElement
    className="absolute bottom-1/3 left-1/4 bg-blue-500/10 border-2 border-blue-400 text-white p-4 rounded-lg w-48 shadow-lg"
    client:load
  >
    <div class="text-3xl mb-2">🌍</div>
    <h3 class="font-bold text-sm">Multiple Planets</h3>
    <p class="text-xs text-blue-200 mt-1">Explore the galaxy</p>
  </SolidElement>

  <SolidElement
    className="absolute top-1/2 right-1/4 bg-blue-500/10 border-2 border-blue-400 text-white p-4 rounded-lg w-48 shadow-lg"
    client:load
  >
    <div class="text-3xl mb-2">👥</div>
    <h3 class="font-bold text-sm">Multiplayer</h3>
    <p class="text-xs text-blue-200 mt-1">Play with friends</p>
  </SolidElement>

  <div
    class="absolute top-1/2 right-20 w-16 h-16 border-2 border-blue-400/30 rounded-full animate-spin"
    style="animation-duration: 8s;"
  >
  </div>
</GameSection>
